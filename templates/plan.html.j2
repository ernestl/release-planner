<!DOCTYPE html>
<html lang="en" class="dashboard-layout">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{ plan_name }}</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    
    <!-- CSS Files -->
    <link rel="stylesheet" href="static/css/main.css">
    <link rel="stylesheet" href="static/css/sidebar.css">
    <link rel="stylesheet" href="static/css/timeline.css">
    
    <style>
        /* Inline styles for quick loading */
        .loading-overlay {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: var(--color-bg);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 9999;
            transition: opacity 0.3s ease;
        }
        
        .loading-overlay.fade-out {
            opacity: 0;
            pointer-events: none;
        }
    </style>
</head>
<body>
    <!-- Loading overlay -->
    <div class="loading-overlay" id="loadingOverlay">
        <div class="loading-content">
            <div style="font-size: 2rem; color: var(--color-primary); margin-bottom: 1rem;">📅</div>
            <h2 style="margin-bottom: 0.5rem;">Loading Release Plan...</h2>
            <p style="color: var(--color-text-muted);">{{ plan_name }}</p>
        </div>
    </div>
    
    <!-- Include header component -->
    {% include 'components/header.j2' %}
    
    <div class="app-container">
        <!-- Include sidebar component -->
        {% include 'components/sidebar.j2' %}
        
        <!-- Main content area -->
        <main class="main-content">
            <!-- Page header -->
            <div class="page-header">
                <div class="page-title">
                    <h1>{{ plan_name }} <span class="badge">{{ project }}</span></h1>
                    <div class="page-meta">
                        <span>Owner: {{ owner }}</span>
                        <span style="margin: 0 0.5rem;">•</span>
                        <span>Generated: {{ generated_at }}</span>
                        <span style="margin: 0 0.5rem;">•</span>
                        <span>Reference date: {{ reference_date }}</span>
                    </div>
                </div>
                <div class="page-controls">
                    <div class="control-group">
                        <button class="btn btn-outline filter-btn" id="filterBtn">
                            <span>Filter</span>
                        </button>
                        <button class="btn btn-outline export-btn" id="exportBtn">
                            <span>Export</span>
                        </button>
                        <button class="btn btn-primary fullscreen-btn" id="fullscreenBtn">
                            <span>Full screen</span>
                        </button>
                    </div>
                </div>
            </div>
            
            <!-- Timeline container -->
            <div class="timeline-container">
                <!-- Timeline controls -->
                <div class="timeline-controls">
                    <div class="zoom-controls">
                        <span style="font-size: var(--font-size-sm); font-weight: 500; color: var(--color-text-muted); margin-right: var(--spacing-sm);">Zoom:</span>
                        {% for zoom_key, zoom_data in zoom_levels.items() %}
                        <button class="zoom-btn {% if zoom_key == '6m' %}active{% endif %}" data-zoom="{{ zoom_key }}">
                            {{ zoom_data.label }}
                        </button>
                        {% endfor %}
                    </div>
                    <div class="control-group">
                        <label for="panToggle">Pan:</label>
                        <div class="toggle-switch">
                            <input type="checkbox" id="panToggle" checked>
                            <label for="panToggle"></label>
                        </div>
                    </div>
                </div>
                
                <!-- Timeline wrapper -->
                <div class="timeline-wrapper">
                    <!-- SVG timeline rendered by backend -->
                    {% include 'plan.svg.j2' %}
                    
                    <!-- Tooltip container -->
                    <div class="tooltip" id="timelineTooltip"></div>
                </div>
            </div>
            
            <!-- Legend -->
            {% include 'components/legend.j2' %}
        </main>
    </div>
    
    <!-- JavaScript data -->
    <script id="plan-data" type="application/json">
        {
            "plan": {
                "name": "{{ plan_name }}",
                "project": "{{ project }}",
                "referenceDate": "{{ reference_date }}"
            },
            "zoomLevels": {
                {% for zoom_key, zoom_data in zoom_levels.items() %}
                "{{ zoom_key }}": {
                    "windowStart": "{{ zoom_data.window_start }}",
                    "windowEnd": "{{ zoom_data.window_end }}",
                    "label": "{{ zoom_data.label }}"
                }{% if not loop.last %},{% endif %}
                {% endfor %}
            },
            "sidebarMetrics": {
                "cycleWindow": {{ sidebar_metrics.cycle_window|tojson }},
                "nextMajorRelease": {{ sidebar_metrics.next_major_release|tojson }},
                "upcomingDeadline": {{ sidebar_metrics.upcoming_deadline|tojson }},
                "activeSprint": {{ sidebar_metrics.active_sprint|tojson }}
            },
            "timeline": {
                "width": {{ render_model.width }},
                "height": {{ render_model.height }},
                "weeks": {{ render_model.weeks|tojson }},
                "months": {{ render_model.months|tojson }},
                "pulses": {{ render_model.pulses|tojson }},
                "lanes": {{ render_model.lanes|tojson }},
                "links": {{ render_model.links|tojson }}
            }
        }
    </script>
    
    <!-- JavaScript Files -->
    <script src="static/js/app.js"></script>
    <script src="static/js/timeline.js"></script>
    <script src="static/js/zoom.js"></script>
    <script src="static/js/filters.js"></script>
    
    <script>
        // Quick inline script to hide loading overlay
        window.addEventListener('load', function() {
            setTimeout(function() {
                document.getElementById('loadingOverlay').classList.add('fade-out');
                setTimeout(function() {
                    document.getElementById('loadingOverlay').style.display = 'none';
                }, 300);
            }, 500);
        });
    </script>
</body>
</html>