<svg
  class="timeline-svg"
  width="{{ render_model.width }}"
  height="{{ render_model.height }}"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-label="Release timeline"
  id="timelineSvg"
>
  <style>
    .timeline-svg {
      background: linear-gradient(180deg, #ffffff 0%, #f9fbfd 100%);
    }
    .row-label-bg { fill: #eef2f6; }
    .row-label-text { fill: #2d3845; font-size: 12px; font-weight: 700; letter-spacing: 0.02em; font-family: "IBM Plex Sans", "Segoe UI", sans-serif; }
    .month-cell { fill: #e8eff7; stroke: #cbd7e5; stroke-width: 1; }
    .month-text { fill: #223142; font-size: 12px; font-weight: 700; text-anchor: middle; font-family: "IBM Plex Sans", "Segoe UI", sans-serif; }
    .week-cell { fill: #ffffff; stroke: #dde4ec; stroke-width: 1; }
    .week-text { fill: #4a5562; font-size: 10px; font-weight: 600; font-family: "IBM Plex Sans", "Segoe UI", sans-serif; }
    .week-text-top { text-anchor: middle; }
    .pulse-cell { fill: #d9efe9; stroke: #a9d7cc; stroke-width: 1; }
    .pulse-text { fill: #145a4d; font-size: 12px; font-weight: 700; text-anchor: middle; dominant-baseline: middle; font-family: "IBM Plex Sans", "Segoe UI", sans-serif; }
    .week-divider { stroke: #c5d0dc; stroke-width: 1.25; stroke-dasharray: 1.5 4; stroke-linecap: round; }
    .lane-band { fill: #f6f9fc; stroke: #dce5ef; stroke-width: 1; }
    .lane-name { fill: #1f2937; font-size: 14px; font-weight: 700; font-family: "IBM Plex Sans", "Segoe UI", sans-serif; }
    .item { stroke-width: 1; fill-opacity: 0.96; }
    .item.base { fill: #5f6975; stroke: #4b5563; }
    .item.sprint { fill: #0f74a8; stroke: #075985; }
    .item.release { fill: #6d28d9; stroke: #5b21b6; }
    .item.holiday { fill: #b66516; stroke: #8a4a0f; }
    /* Enhanced deadline styling */
    .milestone-deadline { 
      fill: #be123c; 
      stroke: #9f1239; 
      stroke-width: 1.5;
      filter: url(#deadline-glow);
    }
    .milestone-deadline:hover { 
      fill: #dc2626; 
      stroke: #991b1b; 
      stroke-width: 2;
    }
    .item-label-inside { fill: #ffffff; font-size: 12px; font-weight: 700; pointer-events: none; font-family: "IBM Plex Sans", "Segoe UI", sans-serif; }
    .item-label-centered { text-anchor: middle; }
    .item-label-inside.deadline-label {
      fill: #7f1d1d;
      font-size: 11px;
      font-weight: 700;
    }
    .item-label-inside.deadline-label-date {
      fill: #9f1239;
      font-size: 10px;
      font-weight: 600;
    }
    .link-line { stroke-width: 1.8; stroke-dasharray: 4 3; fill: none; opacity: 0.9; }
  </style>

  <rect width="100%" height="100%" fill="#ffffff" />

  <defs>
    <marker id="arrowhead" markerWidth="8" markerHeight="6" refX="7" refY="3" orient="auto" markerUnits="strokeWidth">
      <path d="M0,0 L8,3 L0,6 z" fill="context-stroke" />
    </marker>
    
    <!-- Glow effect for deadlines -->
    <filter id="deadline-glow" x="-50%" y="-50%" width="200%" height="200%">
      <feGaussianBlur in="SourceAlpha" stdDeviation="2" result="blur"/>
      <feOffset in="blur" dx="0" dy="0" result="offsetBlur"/>
      <feFlood flood-color="#be123c" flood-opacity="0.3" result="glowColor"/>
      <feComposite in="glowColor" in2="offsetBlur" operator="in" result="softGlow"/>
      <feMerge>
        <feMergeNode in="softGlow"/>
        <feMergeNode in="SourceGraphic"/>
      </feMerge>
    </filter>
  </defs>

  <rect class="row-label-bg" x="0" y="{{ render_model.month_y }}" width="{{ render_model.left_label_width }}" height="{{ render_model.month_row_height }}" />
  <rect class="row-label-bg" x="0" y="{{ render_model.week_y }}" width="{{ render_model.left_label_width }}" height="{{ render_model.week_row_height }}" />
  <rect class="row-label-bg" x="0" y="{{ render_model.pulse_y }}" width="{{ render_model.left_label_width }}" height="{{ render_model.pulse_row_height }}" />
  <text class="row-label-text" x="16" y="{{ render_model.month_y + 24 }}">MONTH</text>
  <text class="row-label-text" x="16" y="{{ render_model.week_y + 27 }}">WEEK</text>
  <text class="row-label-text" x="16" y="{{ render_model.pulse_y + 26 }}">PULSE</text>

  {% for month in render_model.months %}
  <rect class="month-cell" x="{{ month.x }}" y="{{ render_model.month_y }}" width="{{ month.width }}" height="{{ render_model.month_row_height }}" />
  <text class="month-text" x="{{ month.x + (month.width / 2) }}" y="{{ render_model.month_y + 24 }}">{{ month.label }}</text>
  {% endfor %}

  {% for week in render_model.weeks %}
  <rect class="week-cell" x="{{ week.x }}" y="{{ render_model.week_y }}" width="{{ week.width }}" height="{{ render_model.week_row_height }}" />
  <text class="week-text week-text-top" x="{{ week.x + (week.width / 2) }}" y="{{ render_model.week_y + 16 }}">{{ week.week_label }}</text>
  <text class="week-text" x="{{ week.x + 5 }}" y="{{ render_model.week_y + 31 }}">{{ week.range_label }}</text>
  {% endfor %}

  {% for pulse in render_model.pulses %}
  <rect class="pulse-cell" x="{{ pulse.x }}" y="{{ render_model.pulse_y }}" width="{{ pulse.width }}" height="{{ render_model.pulse_row_height }}" />
  <text class="pulse-text" x="{{ pulse.x + (pulse.width / 2) }}" y="{{ render_model.pulse_y + (render_model.pulse_row_height / 2) + 1 }}">{{ pulse.label }}</text>
  {% endfor %}

  {% for lane in render_model.lanes %}
  <rect
    class="lane-band"
    x="{{ render_model.grid_x }}"
    y="{{ lane.y }}"
    width="{{ render_model.grid_width }}"
    height="{{ lane.height }}"
    rx="8"
  />
  <text class="lane-name" x="16" y="{{ lane.label_y }}">{{ lane.name }}</text>

  {% for week in render_model.weeks %}
  <line class="week-divider" x1="{{ week.x }}" y1="{{ lane.y }}" x2="{{ week.x }}" y2="{{ lane.y + lane.height }}" />
  {% endfor %}

  {% for item in lane["items"] %}
  {% if item.shape == "diamond" %}
  <polygon
    class="milestone-deadline"
    points="{{ item.diamond_points }}"
    {% if item.fill_color and item.stroke_color %}
    style="fill: {{ item.fill_color }}; stroke: {{ item.stroke_color }};"
    {% endif %}
  >
    <title>{{ item.label }}: {{ item.start }}</title>
  </polygon>
  {% else %}
  <rect
    class="item {{ lane.class_name }}"
    x="{{ item.x }}"
    y="{{ item.y }}"
    width="{{ item.width }}"
    height="{{ item.height }}"
    rx="6"
    {% if item.fill_color and item.stroke_color %}
    style="fill: {{ item.fill_color }}; stroke: {{ item.stroke_color }};"
    {% endif %}
  >
    <title>{{ item.label }}: {{ item.start }} to {{ item.end }}</title>
  </rect>
  {% endif %}

  {% for line in item.text_lines %}
  <text class="{{ line.class_name }}" x="{{ line.x }}" y="{{ line.y }}">{{ line.text }}</text>
  {% endfor %}
  {% endfor %}
  {% endfor %}

  {% for link in render_model.links %}
  <line
    class="link-line"
    x1="{{ link.x1 }}"
    y1="{{ link.y1 }}"
    x2="{{ link.x2 }}"
    y2="{{ link.y2 }}"
    style="stroke: {{ link.color }};"
    marker-end="url(#arrowhead)"
  />
  {% endfor %}
</svg>
